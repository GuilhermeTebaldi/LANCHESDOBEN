{
  "name": "xburger-local-print-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Agente local de impressão Windows para PDV XBURGER",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build:exe": "pkg src/server.js --targets node20-win-x64 --output dist/xburger-print-agent.exe"
  },
  "dependencies": {
    "cors": "^2.8.5",
