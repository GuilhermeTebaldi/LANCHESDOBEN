{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "*.d.ts",
    "*.ts",
    "*.tsx",
    "components/**/*.d.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "data/**/*.d.ts",
    "data/**/*.ts",
    "utils/**/*.d.ts",
    "utils/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "backend",
    "SITElanchesdoben",
    "dist",
    ".tmp",
    "node_modules"
  ]
}
